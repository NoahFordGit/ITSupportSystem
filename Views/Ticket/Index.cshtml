@model IEnumerable<ITSupportSystem.Core.Entities.Ticket>
@{
    ViewData["Title"] = "Tickets";
}
<h1>Tickets Index</h1>
<p>View all tickets</p>

<button id="openCreateBtn" type="button" class="btn btn-primary">Create a Ticket</button>

<table id="ticketTable" class="table table-striped align-middle">
    <thead>
        <tr>
            <th scope="col">TicketId</th>
            <th scope="col">Title</th>
            <th scope="col">Description</th>
            <th scope="col">Priority</th>
            <th scope="col">Status</th>
            <th scope="col">CreatedAt</th>
            <th scope="col">UpdatedAt</th>
        </tr>
    </thead>
    <tbody>
        
    </tbody>

</table>